# Local deterministic composer works without credentials. This is not an AI model.
WEBSITE_AI_PROVIDER=demo
# Use a server-side OpenAI-compatible endpoint when real AI is required.
# WEBSITE_AI_PROVIDER=compatible
# WEBSITE_AI_BASE_URL=https://your-provider.example/v1
# WEBSITE_AI_MODEL=your-model
# WEBSITE_AI_API_KEY=your-server-secret
PORT=4173
# Google Calendar OAuth connection used for webinar Calendar events and Meet links.
GOOGLE_CLIENT_ID=your-web-oauth-client-id
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4173/api/webinars/google/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WEBINAR_TOKEN_ENCRYPTION_KEY=64-character-hex-key
